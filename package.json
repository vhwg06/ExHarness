{
  "name": "exharness-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/core-harness/test/*.test.js",
    "test:core": "node --test packages/core-harness/test/*.test.js",
    "example": "node examples/reference-harness.mjs",
    "benchmark": "node benchmarks/kernel-benchmark.mjs",
    "eval:reference": "node scripts/reference-eval.mjs",
    "eval:fidelity": "node scripts/fidelity-eval.mjs",
    "eval:turn-memory": "node scripts/turn-memory-eval.mjs",
    "eval:cognition": "node scripts/cognition-eval.mjs",
    "verify:package": "npm pack --dry-run --workspace packages/core-harness",
    "verify:consumer": "node scripts/consumer-smoke.mjs && node scripts/discovery-consumer-smoke.mjs && node scripts/javascript-codeact-consumer-smoke.mjs",
    "verify": "npm run eval:cognition && npm test && npm run example && npm run benchmark && npm run eval:reference && npm run eval:fidelity && npm run eval:turn-memory && npm run verify:package && npm run verify:consumer"
  }
}
