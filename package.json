{
  "name": "exharness-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/core-harness/test/*.test.js",
    "test:core": "node --test packages/core-harness/test/*.test.js",
    "example": "node examples/reference-harness.mjs",
    "benchmark": "node benchmarks/kernel-benchmark.mjs",
    "verify:package": "npm pack --dry-run --workspace packages/core-harness",
    "verify:consumer": "node scripts/consumer-smoke.mjs",
    "verify": "npm test && npm run example && npm run benchmark && npm run verify:package && npm run verify:consumer"
  }
}
