{
  "name": "exharness-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "materialize:blackboard-evaluation": "node scripts/blackboard-jev-cli.mjs materialize",
    "eval:blackboard-jev": "node scripts/blackboard-jev-cli.mjs evaluate",
    "publish:blackboard-evaluation": "node scripts/blackboard-jev-cli.mjs publish",
    "collect:blackboard-evidence": "node scripts/blackboard-jev-cli.mjs collect",
    "verify:blackboard-delivery": "node scripts/blackboard-jev-cli.mjs verify-delivery",
    "publish:blackboard-delivery": "node scripts/blackboard-jev-cli.mjs publish-delivery",
    "claim:blackboard": "node scripts/blackboard-jev-cli.mjs claim",
    "migrate:blackboard-delivery": "node scripts/blackboard-delivery-migrate.mjs",
    "eval:blackboard-jev-stability": "node scripts/blackboard-jev-stability.mjs",
    "test:blackboard-jev": "node --test test/blackboard-jev.test.mjs",
    "verify:blackboard-delivery-contracts": "node scripts/blackboard-delivery-verify.mjs",
    "test": "npm run test:core && npm run test:agentic",
    "test:core": "node --test packages/core-harness/test/*.test.js",
    "test:agentic": "node --test packages/agentic-system/test/*.test.js",
    "example": "node examples/reference-harness.mjs",
    "benchmark": "node benchmarks/kernel-benchmark.mjs",
    "eval:reference": "node scripts/reference-eval.mjs",
    "eval:agentic": "node scripts/agentic-backend-qa-eval.mjs",
    "eval:workflow-replay": "node scripts/workflow-policy-replay-eval.mjs",
    "eval:memory-reuse": "node scripts/semantic-memory-reuse-eval.mjs",
    "eval:self-upgrade-research": "node scripts/self-upgrade-loop-eval.mjs",
    "eval:artifact-manifest-research": "node scripts/artifact-manifest-eval.mjs",
    "eval:fidelity": "node scripts/fidelity-eval.mjs",
    "eval:turn-memory": "node scripts/turn-memory-eval.mjs",
    "eval:cognition": "node scripts/cognition-eval.mjs",
    "verify:package": "npm pack --dry-run --workspace packages/core-harness",
    "verify:consumer": "node scripts/consumer-smoke.mjs && node scripts/discovery-consumer-smoke.mjs && node scripts/javascript-codeact-consumer-smoke.mjs && node scripts/cognition-consumer-smoke.mjs",
    "verify": "npm test && npm run example && npm run benchmark && npm run eval:reference && npm run eval:agentic && npm run eval:workflow-replay && npm run eval:memory-reuse && npm run eval:self-upgrade-research && npm run eval:artifact-manifest-research && npm run eval:fidelity && npm run eval:turn-memory && npm run eval:cognition && npm run verify:package && npm run verify:consumer && npm run verify:blackboard-context && npm run verify:current-docs",
    "test:blackboard-context": "node --test test/blackboard-context-*.test.mjs",
    "verify:blackboard-context": "npm run verify:blackboard-artifacts && npm run verify:blackboard-work-graph && node scripts/blackboard-context-verify.mjs && npm run test:blackboard-context && npm run test:blackboard-jev && npm run eval:blackboard-context",
    "eval:blackboard-context": "node scripts/blackboard-context-eval.mjs",
    "test:blackboard-artifacts": "node --test test/blackboard-artifact-*.test.mjs",
    "verify:blackboard-artifacts": "node scripts/blackboard-artifact-verify.mjs && npm run test:blackboard-artifacts",
    "materialize:blackboard-context": "node scripts/blackboard-context-materialize.mjs",
    "start:blackboard-implementation": "node scripts/blackboard-implementation-bootstrap.mjs",
    "verify:current-docs": "node scripts/current-docs-verify.mjs",
    "test:blackboard-work-graph": "node --test test/blackboard-work-graph.test.mjs test/blackboard-task-context-resolver.test.mjs",
    "verify:blackboard-work-graph": "node scripts/blackboard-work-graph.mjs && npm run verify:blackboard-delivery-contracts && npm run verify:blackboard-state && npm run test:blackboard-work-graph",
    "resolve:blackboard-task-context": "node scripts/blackboard-task-context-resolver.mjs",
    "project:blackboard-state": "node scripts/blackboard-state-project.mjs --write",
    "verify:blackboard-state": "node scripts/blackboard-state-project.mjs --verify"
  }
}
